<Portal::ContentWrapper class="portal-page-card portal-table-page-card">
    <div class="portal-section-header">
        <div>
            <div class="portal-section-eyebrow">Billing Center</div>
            <h1>Billing</h1>
            <p>View invoices, balances, receipts, and payment status.</p>
        </div>
        {{#if this.model.billingError}}<p role="alert">Unable to load order invoices. Refresh to try again.</p>{{/if}}
    </div>
    <div class="next-table-wrapper no-scroll h-auto table-fluid portal-table-panel mt-5">
        <table class="table table-fixed portal-table">
            <thead>
                <tr>
                    <th class="text-left">Invoice</th>
                    <th class="text-left">Order</th>
                    <th class="text-left">Due</th>
                    <th class="text-left">Status</th>
                    <th class="text-right">Balance</th>
                    <th class="text-left">PDF</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.model.invoices as |invoice|}}
                    <tr>
                        <td class="font-semibold">
                            <LinkTo @route="portal.billing.details" @model={{or invoice.public_id invoice.id}} class="portal-table-link">
                                {{or invoice.number invoice.public_id invoice.id}}
                            </LinkTo>
                        </td>
                        <td>
                            {{#if (or invoice.order_public_id invoice.order_uuid)}}
                                <LinkTo @route="portal.orders.details" @model={{or invoice.order_public_id invoice.order_uuid}} class="portal-table-link">
                                    {{or invoice.order_tracking_number invoice.order_public_id invoice.order_uuid}}
                                </LinkTo>
                            {{else}}
                                <span class="text-gray-400">-</span>
                            {{/if}}
                        </td>
                        <td>{{n-a (format-date-fns invoice.due_date "yyyy-MM-dd")}}</td>
                        <td><Badge @status={{invoice.status}} /></td>
                        <td class="text-right">{{invoice-money (or invoice.balance 0) invoice.currency}}</td>
                        <td><Portal::InvoicePdfActions @invoice={{invoice}} /></td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="6">
                            <div class="portal-empty-state portal-table-empty-state">
                                <div class="portal-empty-state-icon"><FaIcon @icon="file-invoice-dollar" /></div>
                                <div class="portal-empty-state-title">No invoices yet</div>
                                <p>Invoices, receipts, and balances will appear here when billing records are available for this account.</p>
                            </div>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="portal-section-header mt-5">
        <div><h2>Monthly COD fee invoices</h2><p>Fees and VAT already deducted from collected COD. No additional payment is due.</p></div>
    </div>
    {{#if this.model.feeInvoicesError}}<p role="alert">Unable to load COD fee invoices. Refresh to try again.</p>{{/if}}
    <div class="next-table-wrapper no-scroll h-auto table-fluid portal-table-panel mt-5">
        <table class="table portal-table">
            <thead><tr><th class="text-left">Invoice</th><th class="text-left">Period</th><th class="text-left">Status</th><th class="text-right">Fees</th><th class="text-right">VAT</th><th class="text-right">Total</th><th class="text-left">PDF</th></tr></thead>
            <tbody>
                {{#each this.model.feeInvoices as |invoice|}}
                    <tr>
                        <td>{{invoice.number}}</td><td>{{invoice.period}}</td><td><Badge @status={{invoice.status}} /></td>
                        <td class="text-right">{{invoice-money invoice.fee_total invoice.currency}}</td>
                        <td class="text-right">{{invoice-money invoice.vat_total invoice.currency}}</td>
                        <td class="text-right">{{invoice-money invoice.total invoice.currency}}</td>
                        <td><Portal::InvoicePdfActions @invoice={{invoice}} @kind="cod" /></td>
                    </tr>
                {{else}}
                    <tr><td colspan="7">No monthly COD fee invoices yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</Portal::ContentWrapper>
