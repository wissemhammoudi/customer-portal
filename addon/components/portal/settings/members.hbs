<div class="space-y-4">
    {{#if this.canSubmit}}<Portal::BusinessProfile />{{/if}}
    <div class="portal-account-card space-y-4">
        <h2 class="font-bold">{{t "customer-team.title"}}</h2>
        <p>{{t "customer-team.explanation"}}</p>
        <Button @text={{t "customer-business.refresh"}} @onClick={{perform this.load}} @disabled={{this.mutate.isRunning}} />
        {{#if this.error}}<p role="alert" class="text-red-600">{{this.error}}</p>{{/if}}
        {{#each this.inbox as |invitation|}}
            <div class="border rounded p-3 space-y-2">
                <p>{{invitation.company_name}} - {{invitation.role}}</p>
                <Button @text={{t "customer-team.accept"}} @onClick={{fn this.accept invitation}} @disabled={{this.mutate.isRunning}} />
            </div>
        {{/each}}
        {{#if this.canInvite}}
            <form class="space-y-3" {{on "submit" (perform this.invite)}}>
                <InputGroup @name={{t "customer-team.name"}} @value={{this.name}} />
                <InputGroup @name={{t "customer-team.email"}} @type="email" @value={{this.email}} />
                <label class="block">
                    {{t "customer-team.role"}}
                    <select class="form-select" {{on "change" this.setRole}}>
                        {{#each this.roles as |role|}}<option value={{role}} selected={{eq role this.role}}>{{t (concat "customer-team.roles." role)}}</option>{{/each}}
                    </select>
                </label>
                <Button @buttonType="submit" @text={{t "customer-team.invite"}} @disabled={{or this.mutate.isRunning this.load.isRunning}} />
            </form>
            {{#each this.invitations as |invitation|}}
                <div class="border rounded p-3">
                    <p>{{invitation.name}} - {{invitation.email}} - {{invitation.role}}</p>
                    <Button @text={{t "customer-team.resend"}} @onClick={{fn this.resend invitation}} @disabled={{this.mutate.isRunning}} />
                    <Button @text={{t "customer-team.cancel"}} @onClick={{fn this.cancel invitation}} @disabled={{this.mutate.isRunning}} />
                </div>
            {{/each}}
            {{#each this.members as |member|}}
                <div class="border rounded p-3 space-y-2">
                    <p>{{member.name}} - {{member.email}} - {{member.status}}</p>
                    {{#if (eq member.role "owner")}}
                        <p>{{t "customer-team.roles.owner"}}</p>
                    {{else}}
                        <label>
                            {{t "customer-team.role"}}
                            <select class="form-select" disabled={{this.mutate.isRunning}} {{on "change" (fn this.changeRole member)}}>
                                {{#each this.roles as |role|}}<option value={{role}} selected={{eq role member.role}}>{{t (concat "customer-team.roles." role)}}</option>{{/each}}
                            </select>
                        </label>
                        <Button @text={{t "customer-team.toggle"}} @onClick={{fn this.toggle member}} @disabled={{this.mutate.isRunning}} />
                    {{/if}}
                </div>
            {{/each}}
        {{/if}}
    </div>
</div>