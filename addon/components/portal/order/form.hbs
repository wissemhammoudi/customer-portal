<div class="contents" {{did-insert this.initialize}} {{did-update this.refreshServiceQuotes this.quoteRevision this.deliveryOptions.catalogue}}>
    <Overlay @position="right" @noBackdrop={{true}} @fullHeight={{true}} @width="500px" @isOpen={{true}} @overlayClass="portal-order-panel-overlay" as |overlay|>
        <Overlay::Header @overlay={{overlay}} @title={{t "customer-ux.create"}} @onPressCancel={{this.cancel}}>
            <:actions>
                {{#if (eq this.step 3)}}
                    <Button
                        @icon="check"
                        @type="primary"
                        @text={{if this.isPaymentRequired (t "customer-ux.continue-payment") (t "customer-ux.create")}}
                        @onClick={{this.submit}}
                        @isLoading={{this.customerPortalOrderActions.createOrder.isRunning}}
                        @disabled={{not this.canSubmit}}
                    />
                {{/if}}
            </:actions>
        </Overlay::Header>
        <Overlay::Body @wrapperClass="portal-order-overlay-body">
            <div class="portal-ux-step" role="status" data-test-order-step>
                <h2>{{t "customer-ux.step" number=this.stepNumber title=this.stepTitle}}</h2>
                <p>{{t "customer-ux.creation-help"}}</p>
            </div>
            {{#if this.draft.blockedReason}}
                <InfoBlock @text={{this.draft.blockedReason}} />
            {{/if}}
            {{#if this.draft.pickupChanged}}
                <InfoBlock
                    @text="Your account pickup address changed since this draft was saved. Confirm using the current Profile/Settings address as the delivery pickup or return dropoff; previous rates will be discarded."
                />
                <Button @text="Use current account pickup" @onClick={{this.customerPortalOrderCreation.acknowledgePickupChange}} />
            {{/if}}
            {{#if (eq this.step 0)}}
                <Portal::Order::Form::Details @draft={{this.draft}} @orderConfigs={{@model.orderConfigs}} @section="purpose" />
                <Portal::Order::Form::Route @draft={{this.draft}} @places={{@model.places}} />
            {{/if}}
            {{#if (eq this.step 1)}}
                <Portal::Order::Form::Payload @draft={{this.draft}} />
                <Portal::Order::Form::Details @draft={{this.draft}} @orderConfigs={{@model.orderConfigs}} @section="parcels" />
            {{/if}}
            {{#if (eq this.step 2)}}
                <Portal::Order::Form::Details @draft={{this.draft}} @orderConfigs={{@model.orderConfigs}} @section="service" />
                <Button @text={{t "customer-ux.additional"}} @onClick={{this.toggleAdditional}} />
                {{#if this.showAdditional}}
                    <Portal::Order::Form::CustomFields @draft={{this.draft}} />
                    <Portal::Order::Form::Documents @draft={{this.draft}} />
                    <Portal::Order::Form::Notes @draft={{this.draft}} />
                {{/if}}
            {{/if}}
            {{#if (eq this.step 3)}}
                <section class="portal-ux-step" data-test-order-review>
                    <h2>{{t "customer-ux.review"}}</h2>
                    <p>{{t "customer-ux.pickup"}}: {{place-address this.draft.payload.pickup}}</p>
                    <p>{{t "customer-ux.recipient"}}: {{place-address this.draft.payload.dropoff}}</p>
                    {{#each this.draft.payload.waypoints as |stop|}}<p>{{place-address stop.place}}</p>{{/each}}
                    {{#each this.draft.payload.entities as |parcel|}}<p>{{parcel.quantity}} x {{parcel.name}}</p>{{/each}}
                    <p>{{this.draft.meta.delivery.service_level}}</p>
                    <p>{{t "customer-ux.collection-amount"}}: {{or this.draft.payload.cod_amount "0"}} {{this.draft.payload.cod_currency}}</p>
                    {{#if this.draft.notes}}<p>{{this.draft.notes}}</p>{{/if}}
                </section>
                <Portal::Order::Form::ServiceRate @draft={{this.draft}} @isLoading={{this.customerPortalOrderActions.loadServiceQuotes.isRunning}} @canQuote={{this.canQuote}} />
                <Button @text="Refresh delivery rates" @onClick={{this.retryServiceQuotes}} @disabled={{or (not this.canQuote) this.isLoadingServiceQuotes}} />
                {{#if this.draft.uploadsPending}}
                    <InfoBlock @text="Documents are uploading. Please wait before creating the delivery." />
                {{else}}
                    {{#unless this.canSubmit}}
                        <InfoBlock @text="Complete the route, named parcels and packaging, COD and proof settings, then select a current delivery rate." />
                    {{/unless}}
                {{/if}}
                <Button
                    @text={{if this.isPaymentRequired (t "customer-ux.continue-payment") (t "customer-ux.create")}}
                    @type="primary"
                    @onClick={{this.submit}}
                    @disabled={{not this.canSubmit}}
                    @isLoading={{this.customerPortalOrderActions.createOrder.isRunning}}
                    data-test-order-submit
                />
            {{else}}
                {{#unless this.canContinue}}<p role="status" class="portal-ux-step">{{t "customer-ux.step-help"}}</p>{{/unless}}
                <Button @text={{t "customer-ux.continue"}} @type="primary" @onClick={{this.nextStep}} @disabled={{not this.canContinue}} data-test-order-next />
            {{/if}}
            {{#if this.step}}<Button
                    @text={{t "customer-ux.back"}}
                    @onClick={{this.previousStep}}
                    @disabled={{or this.checkoutStarting this.customerPortalOrderActions.createOrder.isRunning}}
                    data-test-order-back
                />{{/if}}
            <Spacer @height="40px" />
        </Overlay::Body>
    </Overlay>
</div>