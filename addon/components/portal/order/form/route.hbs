<ContentPanel @title="Route" @open={{true}} @actionButtons={{this.actionButtons}} @wrapperClass="bordered-top">
    <InputGroup @name="Account pickup (read-only)" @required={{true}}>
        {{#if @draft.payload.pickup}}
            <div class="form-input">
                {{place-address @draft.payload.pickup}}
                <div>{{@draft.payload.pickup.phone}}</div>
            </div>
        {{/if}}
        <p>Pickup is shared by everyone on your seller account. Edit it only in Profile/Settings.</p>
        {{#unless this.validPickup}}
            <InfoBlock @text="Save an account pickup address with street, phone and coordinates in Profile/Settings before requesting a quote or creating an order." />
        {{/unless}}
    </InputGroup>
    <InputGroup @name="Dropoff" @required={{true}} @helpText="A contact phone is required. Confirmed addresses are saved to your address book automatically.">
        <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
            <PowerSelect
                @options={{this.places}}
                @search={{perform this.searchPlaces}}
                @searchEnabled={{true}}
                @selected={{@draft.payload.dropoff}}
                @onChange={{fn this.setPayloadPlace "dropoff"}}
                @placeholder="Select dropoff place"
                @allowClear={{true}}
                @triggerClass="form-select form-input"
                @renderInPlace={{true}}
                as |place|
            >
                {{place-address place}}
            </PowerSelect>
        </div>
        {{#if @draft.payload.dropoff}}
            <Button @text="Edit dropoff" @onClick={{fn this.openEditPlaceForm "dropoff" @draft.payload.dropoff}} />
        {{/if}}
    </InputGroup>
</ContentPanel>