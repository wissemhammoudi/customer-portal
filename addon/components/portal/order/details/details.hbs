<ContentPanel @title="Details" @open={{true}} @wrapperClass="bordered-top">
    <div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Recipient opening</div>
            <div class="field-value">{{if @resource.meta.delivery.opening_allowed "Allowed: supervised visual inspection before acceptance/payment. No use or testing." "Not allowed before acceptance."}}</div>
        </div>
        {{#if (eq @resource.meta.recipient_handoff.latest.status "refused")}}
            <div role="alert">
                <strong>Recipient refused: {{@resource.meta.recipient_handoff.latest.reason}}</strong>
                <p>Contact operations to arrange a return. Do not mark delivered or collect COD. Return charges require an agreed policy.</p>
            </div>
        {{/if}}
        {{#if @resource.meta.delivery}}
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">Delivery options</div>
                <div class="field-value">{{smart-humanize @resource.meta.delivery.purpose}} / {{smart-humanize @resource.meta.delivery.service_level}}</div>
            </div>
        {{/if}}
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Order ID</div>
            <ClickToCopy @value={{@resource.public_id}} class="field-value">{{n-a @resource.public_id}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Tracking Number</div>
            <ClickToCopy @value={{@resource.tracking_number.tracking_number}} class="field-value">{{n-a @resource.tracking_number.tracking_number}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Scheduled</div>
            <div class="field-value">{{n-a (format-date-fns @resource.scheduled_at "MMM d, yyyy HH:mm")}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Created</div>
            <div class="field-value">{{n-a (format-date-fns @resource.created_at "MMM d, yyyy HH:mm")}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Type</div>
            <div class="field-value">{{n-a (smart-humanize @resource.type)}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">Proof of Delivery</div>
            <div class="field-value">{{if @resource.pod_required (smart-humanize @resource.pod_method) "Not required"}}</div>
        </div>
        <div class="field-info-container field-vertical-container">
            <div class="field-name">Notes</div>
            <div class="field-value">{{n-a @resource.notes "No notes provided."}}</div>
        </div>
    </div>
</ContentPanel>
{{#if (eq @resource.meta.packaging_inspection.latest.status "refused")}}
    <div role="alert" class="p-3 border rounded">
        <strong>Pickup refused: non-compliant packaging.</strong>
        <p>{{@resource.meta.packaging_inspection.latest.reason}}</p>
        <p>Repackage the goods according to the Colab Express guide. The order is not canceled; the driver must record a new compliant check before pickup.</p>
    </div>
{{/if}}